<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eyefind_bg">

    <LinearLayout
        android:id="@+id/topStrip"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/eyefind_red"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="It's like a series of tubes"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/portalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/statusBar"
        app:layout_constraintTop_toBottomOf="@id/topStrip">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:contentDescription="Eyefind logo"
                    android:src="@drawable/eyefind_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="eyefind.info"
                    android:textColor="@color/eyefind_blue"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_background"
                    android:hint="Search Eyefind"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/searchButton"
                    android:layout_width="86dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="7dp"
                    android:backgroundTint="@color/eyefind_red"
                    android:text="Search"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/categoriesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:columnCount="2"
                android:rowCount="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMedia"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="MEDIA AND ENTERTAINMENT"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_media"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFood"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="FOOD AND DRINK"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_food"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMoney"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="MONEY AND SERVICES"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_money"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTravel"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="TRAVEL AND TRANSPORT"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_travel"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFashion"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="FASHION AND HEALTH"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_fashion"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRandom"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="@color/category_grey"
                    android:text="RANDOM"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="10sp"
                    app:cornerRadius="7dp"
                    app:icon="@drawable/ic_random"
                    app:iconGravity="top"
                    app:iconSize="28dp"
                    app:iconTint="@null" />
            </GridLayout>

            <LinearLayout
                android:id="@+id/newsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/portal_panel_border"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEWS STORY OF THE DAY"
                    android:textColor="@color/eyefind_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/newsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/eyefind_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/websiteOfMinuteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/portal_panel_border"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEBSITE OF THE MINUTE"
                    android:textColor="@color/eyefind_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/websiteOfMinuteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/eyefind_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/websiteOfMinuteUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/eyefind_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/ad_banner"
                android:gravity="center"
                android:text="SPONSORED: BAWSAQ - LOSE MONEY FASTER"
                android:textColor="@color/eyefind_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/tor_status_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/statusIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Checking Tor"
            android:textColor="@color/tor_starting"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/newIdentityButton"
            android:layout_width="112dp"
            android:layout_height="32dp"
            android:backgroundTint="@color/eyefind_red"
            android:text="New Identity"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
